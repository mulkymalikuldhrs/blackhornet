#!/usr/bin/env python3
"""
BH DOCTOR — ONE Launcher for the entire autonomous ecosystem.

Replaces: blackhornet.py, unified_launcher.py (CLI part), keeper.py,
          watchdow.py, immortal_daemon.py, memory_bridge.py

Usage:
    bh-doctor start       Start all services
    bh-doctor stop        Graceful shutdown
    bh-doctor status      System status
    bh-doctor doctor      Diagnose and fix
    bh-doctor graph       Export knowledge graph
    bh-doctor export      Export session + memory + docs
    bh-doctor tui         Terminal UI
    bh-doctor web [port]  Web dashboard
    bh-doctor e2b         E2B sandbox validation
"""

import argparse
import json
import logging
import os
import signal
import subprocess
import sys
import time
from pathlib import Path
from typing import Any, Dict, List, Optional

VERSION = "5.0.0"
SOVEREIGN = "Mulky Malikul Dhaher"
BASE_DIR = Path(__file__).parent.resolve()
BH_HOME = Path(os.getenv("BH_HOME", Path.home() / ".bh"))

logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(name)s] %(levelname)s: %(message)s")
logger = logging.getLogger("BH.Doctor")


class BHDoctor:
    """Central orchestrator for the BH Doctor ecosystem."""

    def __init__(self):
        self._components: Dict[str, Any] = {}
        self._running = False
        self._start_time = time.time()
        self._pid_dir = BASE_DIR / "data"
        signal.signal(signal.SIGTERM, lambda *_: self.stop())
        signal.signal(signal.SIGINT, lambda *_: self.stop())

    # ── Core Services ──────────────────────────────────────────────

    def start(self) -> Dict[str, Any]:
        results: Dict[str, Any] = {}
        started: List[str] = []

        logger.info("Starting BH Doctor services...")
        (BASE_DIR / "logs").mkdir(parents=True, exist_ok=True)
        (BASE_DIR / "data").mkdir(parents=True, exist_ok=True)
        sys.path.insert(0, str(BASE_DIR / "src"))

        # 1. Graph store
        try:
            from graph.graph_store import GraphStore
            gs = GraphStore()
            self._components["graph_store"] = gs
            started.append("graph_store")
            results["graph"] = "ok"
            logger.info("  ✓ Graph store: %s nodes", gs.stats()["nodes"])
        except Exception as exc:
            results["graph"] = str(exc)
            logger.warning("  ✗ Graph store: %s", exc)

        # 2. Entity tracker
        try:
            from graph.entity_tracker import EntityTracker
            et = EntityTracker(graph_store=self._components.get("graph_store"))
            self._components["entity_tracker"] = et
            started.append("entity_tracker")
            results["entity_tracker"] = "ok"
        except Exception as exc:
            results["entity_tracker"] = str(exc)

        # 3. Relationship mapper
        try:
            from graph.relationship_mapper import RelationshipMapper
            rm = RelationshipMapper(graph_store=self._components.get("graph_store"))
            self._components["relationship_mapper"] = rm
            started.append("relationship_mapper")
            results["relationship_mapper"] = "ok"
        except Exception as exc:
            results["relationship_mapper"] = str(exc)

        # 4. Auto graph updater
        try:
            from graph.auto_updater import AutoGraphUpdater
            agu = AutoGraphUpdater(
                graph_store=self._components.get("graph_store"),
                entity_tracker=self._components.get("entity_tracker"),
                relationship_mapper=self._components.get("relationship_mapper"),
            )
            self._components["auto_graph_updater"] = agu
            started.append("auto_graph_updater")
            results["auto_graph"] = "ok"
        except Exception as exc:
            results["auto_graph"] = str(exc)

        # 5. Memory system
        try:
            from memory.system import MemorySystem
            ms = MemorySystem()
            self._components["memory_system"] = ms
            started.append("memory_system")
            results["memory"] = "ok"
        except Exception as exc:
            results["memory"] = str(exc)

        # 6. Event bus
        try:
            from core.event_bus import EventBus
            eb = EventBus()
            eb._running = True
            self._components["event_bus"] = eb
            started.append("event_bus")
            results["event_bus"] = "ok"
        except Exception as exc:
            results["event_bus"] = str(exc)

        # 7. SessionRecorder (wired to EventBus + AutoGraphUpdater)
        try:
            from graph.session_recorder import SessionRecorder
            sr = SessionRecorder(
                auto_updater=self._components.get("auto_graph_updater"),
                graph_store=self._components.get("graph_store"),
                entity_tracker=self._components.get("entity_tracker"),
                relationship_mapper=self._components.get("relationship_mapper"),
                event_bus=self._components.get("event_bus"),
            )
            sr.start()
            self._components["session_recorder"] = sr
            started.append("session_recorder")
            results["session_recorder"] = "ok"
        except Exception as exc:
            results["session_recorder"] = str(exc)

        # 8. Web server
        try:
            from ui.web_server import WebServer
            ws = WebServer(port=8080)
            if ws.start():
                self._components["web_server"] = ws
                started.append("web_server")
                results["web"] = "ok (port 8080)"
        except Exception as exc:
            results["web"] = str(exc)

        # 9. Record startup in graph
        agu = self._components.get("auto_graph_updater")
        if agu:
            agu.on_episode("bh-doctor", "system_start",
                          f"BH Doctor v{VERSION} started by {SOVEREIGN}")

        self._running = True
        self._save_pid()
        results["_started"] = started
        results["_version"] = VERSION
        results["_sovereign"] = SOVEREIGN
        logger.info("BH Doctor: %d components started", len(started))
        return results

    def stop(self) -> None:
        logger.info("Stopping BH Doctor services...")
        # Stop in reverse initialization order
        for comp_name in reversed(list(self._components.keys())):
            comp = self._components[comp_name]
            try:
                if comp_name == "web_server":
                    comp.stop()
                elif comp_name == "session_recorder":
                    if hasattr(comp, "start"):
                        pass
                elif comp_name == "event_bus":
                    comp._running = False
                    comp.clear_history()
                elif comp_name == "auto_graph_updater":
                    comp.on_episode("bh-doctor", "system_stop",
                                    f"BH Doctor v{VERSION} stopped")
                elif comp_name == "graph_store":
                    if hasattr(comp, "close"):
                        comp.close()
            except Exception:
                pass
        self._running = False
        self._remove_pid()
        logger.info("BH Doctor stopped")

    def _save_pid(self) -> None:
        pid_dir = BASE_DIR / "data"
        pid_dir.mkdir(parents=True, exist_ok=True)
        pid_file = pid_dir / "doctor.pid"
        pid_file.write_text(str(os.getpid()))

    def _remove_pid(self) -> None:
        pid_file = self._pid_dir / "doctor.pid"
        pid_file.unlink(missing_ok=True)

    # ── Status ─────────────────────────────────────────────────────

    def status(self) -> Dict[str, Any]:
        return {
            "system": "BH Doctor",
            "version": VERSION,
            "sovereign": SOVEREIGN,
            "running": self._running,
            "uptime": int(time.time() - self._start_time),
            "components": {
                name: type(comp).__name__
                for name, comp in self._components.items()
            },
        }

    # ── Doctor (Diagnose + Fix) ────────────────────────────────────

    def doctor(self) -> Dict[str, Any]:
        issues: List[str] = []
        fixes: List[str] = []

        # 1. Check graph store
        gs = self._components.get("graph_store")
        if gs:
            try:
                stats = gs.stats()
                if stats["nodes"] == 0:
                    gs.add_node("BH_DOCTOR", "system",
                               {"version": VERSION, "status": "healed"})
                    fixes.append("Graph store reinitialized")
            except Exception as e:
                issues.append(f"Graph store: {e}")
        else:
            issues.append("Graph store not started")

        # 2. Check entity tracker
        et = self._components.get("entity_tracker")
        if not et:
            issues.append("Entity tracker not started")

        # 3. Check relationship mapper
        rm = self._components.get("relationship_mapper")
        if not rm:
            issues.append("Relationship mapper not started")

        # 4. Check auto graph updater
        agu = self._components.get("auto_graph_updater")
        if agu:
            try:
                agu.stats()
            except Exception as e:
                issues.append(f"Auto graph updater: {e}")
        else:
            issues.append("Auto graph updater not started")

        # 5. Check memory system
        ms = self._components.get("memory_system")
        if ms:
            try:
                ms.stats()
            except Exception as e:
                issues.append(f"Memory system: {e}")
        else:
            issues.append("Memory system not started")

        # 6. Check event bus
        eb = self._components.get("event_bus")
        if eb:
            try:
                if not eb.is_running:
                    issues.append("Event bus not running")
            except Exception as e:
                issues.append(f"Event bus: {e}")
        else:
            issues.append("Event bus not started")

        # 7. Check session recorder
        sr = self._components.get("session_recorder")
        if not sr:
            issues.append("Session recorder not started")

        # 8. Check web server
        ws = self._components.get("web_server")
        if ws:
            try:
                if not ws.is_running:
                    issues.append("Web server not running")
            except Exception as e:
                issues.append(f"Web server: {e}")

        # 9. Check PID files
        pid_dir = BASE_DIR / "data"
        for pid_name in ["launcher.pid", "doctor.pid"]:
            pid_file = pid_dir / pid_name
            if pid_file.exists():
                try:
                    pid = int(pid_file.read_text().strip())
                    os.kill(pid, 0)
                except (ProcessLookupError, OSError, ValueError):
                    pid_file.unlink(missing_ok=True)
                    fixes.append(f"Removed stale PID file: {pid_name}")

        # 10. Check log directory
        log_dir = BASE_DIR / "logs"
        if not log_dir.exists():
            log_dir.mkdir(parents=True)
            fixes.append("Created log directory")

        return {
            "issues": issues,
            "fixes": fixes,
            "healthy": len(issues) == 0,
        }

    # ── Graph Export ───────────────────────────────────────────────

    def graph_export(self, format: str = "json") -> str:
        gs = self._components.get("graph_store")
        if not gs:
            return '{"error": "Graph store not available"}'

        if format == "dot":
            try:
                from graph.graph_visualizer import GraphVisualizer
                gv = GraphVisualizer(graph_store=gs)
                return gv.to_dot()
            except Exception as e:
                return f"dot export failed: {e}"
        elif format == "ascii":
            try:
                from graph.graph_visualizer import GraphVisualizer
                gv = GraphVisualizer(graph_store=gs)
                return gv.to_ascii(max_nodes=30)
            except Exception as e:
                return f"ascii export failed: {e}"
        else:
            return json.dumps(gs.export_json(), indent=2, default=str)

    # ── Session Export ─────────────────────────────────────────────

    def export_session(self) -> str:
        ts = time.strftime("%Y%m%d_%H%M%S")
        export_dir = BASE_DIR / "data" / "session-export"
        export_dir.mkdir(parents=True, exist_ok=True)

        # Export graph
        gs = self._components.get("graph_store")
        if gs:
            try:
                data = gs.export_json()
                data["exported_at"] = ts
                data["sovereign"] = SOVEREIGN
                graph_file = export_dir / f"graph_{ts}.json"
                graph_file.write_text(json.dumps(data, indent=2))
            except Exception as e:
                logger.warning("Graph export: %s", e)

        # Export session memory
        mem_file = export_dir / f"session_{ts}.md"
        mem_content = f"""# BH Doctor — Session Export
**Exported at:** {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}
**Sovereign:** {SOVEREIGN}
**Version:** {VERSION}

## System State
- Running: {self._running}
- Uptime: {int(time.time() - self._start_time)}s
- Components: {list(self._components.keys())}

## Graph
- Nodes: {gs.stats()['nodes'] if gs else 'N/A'}
- Edges: {gs.stats()['edges'] if gs else 'N/A'}
"""
        mem_file.write_text(mem_content)

        # Update shared memory
        shared_mem = Path(os.getenv("SHARED_MEMORY", "/sdcard/dhaherlabs/data/shared-memory.md"))
        if shared_mem.exists():
            try:
                content = shared_mem.read_text()
                content += f"\n## Session Export {ts}\n- BH Doctor v{VERSION}\n- Uptime: {int(time.time() - self._start_time)}s\n- Graph exported\n"
                shared_mem.write_text(content)
            except Exception:
                pass

        return f"Exported to {export_dir}"

    # ── E2B Validation ─────────────────────────────────────────────

    def e2b_validate(self) -> Dict[str, Any]:
        try:
            from sandbox.e2b_sandbox import E2BSandbox
            sandbox = E2BSandbox()
            return sandbox.validate()
        except ImportError:
            return {"error": "E2B sandbox not available", "hint": "pip install e2b && export E2B_API_KEY=..."}
        except Exception as e:
            return {"error": str(e)}

    # ─── Runner ────────────────────────────────────────────────────

    def run_forever(self) -> None:
        results = self.start()
        started = results.get("_started", [])
        print(f"\n🖤  BH Doctor v{VERSION}")
        print(f"   Sovereign: {SOVEREIGN}")
        print(f"   Started: {len(started)} components")
        print(f"   Web UI: http://localhost:8080")
        print()
        try:
            cycle = 0
            while self._running:
                cycle += 1
                if cycle % 60 == 0:
                    health = self.doctor()
                    if not health["healthy"]:
                        logger.warning("Health issues: %s", health["issues"])
                time.sleep(1)
        except KeyboardInterrupt:
            pass
        finally:
            self.stop()


def main() -> None:
    parser = argparse.ArgumentParser(description=f"BH Doctor v{VERSION} — ONE Launcher")
    parser.add_argument("command", nargs="?", default="status",
                       choices=["start", "stop", "status", "doctor", "graph", "export", "tui", "web", "e2b"],
                       help="Command to execute")
    parser.add_argument("args", nargs="*", help="Additional arguments")

    args = parser.parse_args()
    doctor = BHDoctor()

    if args.command == "start":
        doctor.run_forever()
    elif args.command == "stop":
        doctor.stop()
    elif args.command == "status":
        s = doctor.status()
        print(f"System:     {s['system']} v{s['version']}")
        print(f"Sovereign:  {s['sovereign']}")
        print(f"Running:    {s['running']}")
        print(f"Uptime:     {s['uptime']}s")
        if s['components']:
            print(f"\nComponents ({len(s['components'])}):")
            for name, ctype in s['components'].items():
                print(f"  ✓ {name} ({ctype})")
    elif args.command == "doctor":
        result = doctor.doctor()
        print(f"Issues: {len(result['issues'])}")
        for issue in result['issues']:
            print(f"  ✗ {issue}")
        print(f"Fixes applied: {len(result['fixes'])}")
        for fix in result['fixes']:
            print(f"  ✓ {fix}")
        print(f"\nHealthy: {result['healthy']}")
    elif args.command == "graph":
        fmt = args.args[0] if args.args else "json"
        print(doctor.graph_export(format=fmt))
    elif args.command == "export":
        path = doctor.export_session()
        print(f"Session exported: {path}")
    elif args.command == "tui":
        try:
            from ui.tui_renderer import TUIShell, TUIRenderer
            from core.event_bus import EventBus
            eb = EventBus()
            tui_renderer = TUIRenderer(event_bus=eb)
            shell = TUIShell(tui_renderer)
            shell.cmdloop()
        except ImportError as e:
            print(f"TUI not available: {e}")
    elif args.command == "web":
        port = int(args.args[0]) if args.args else 8080
        try:
            from ui.web_server import WebServer
            ws = WebServer(port=port)
            if ws.start():
                print(f"Web UI: http://localhost:{port}")
                try:
                    while True:
                        time.sleep(1)
                except KeyboardInterrupt:
                    ws.stop()
            else:
                print(f"Web server failed to start on port {port}")
                sys.exit(1)
        except ImportError as e:
            print(f"Web server not available: {e}")
            print("Try: bh-doctor start")
    elif args.command == "e2b":
        result = doctor.e2b_validate()
        print(json.dumps(result, indent=2))


if __name__ == "__main__":
    main()
