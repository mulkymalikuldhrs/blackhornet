[Unit]
Description=BlackHornet Hive — Autonomous Agent Empire
Documentation=https://github.com/dhaher-labs/blackhornet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/blackhornet-ecosystem/blackhornet
Environment="PATH=/usr/local/bin:/usr/bin:/bin:/root/.local/bin"
Environment="BLACKHORNET_HOME=/root/.blackhornet"
ExecStartPre=/bin/bash -c 'cd /root/blackhornet-ecosystem/JeumpaLLM && PORT=3333 nohup node index.js > /tmp/jeumpallm.log 2>&1 &'
ExecStart=/bin/bash /root/blackhornet-ecosystem/blackhornet/blackhornet.sh swarm
ExecStop=/bin/bash /root/blackhornet-ecosystem/blackhornet/blackhornet.sh stop
Restart=always
RestartSec=10
StandardOutput=append:/root/blackhornet-ecosystem/blackhornet/logs/hive.log
StandardError=append:/root/blackhornet-ecosystem/blackhornet/logs/hive.log

[Install]
WantedBy=multi-user.target