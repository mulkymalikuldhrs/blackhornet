# ============================================================================
# HERMES HIVE — Production Configuration
# ============================================================================
# Owner & Sovereign: Mulky Malikul Dhaher
# Empire: 7 repos, 21+ agents, immortal autonomous ecosystem
# ============================================================================

# ── LLM GATEWAY ────────────────────────────────────────────────────────
# Primary: ProxyGateLLM (local) — 10 free providers, 468 models, zero cost
PROXYGATE_HOST=localhost
PROXYGATE_PORT=3333
PROXYGATE_URL=http://localhost:3333

# Fallback: NVIDIA NIM (if ProxyGateLLM unavailable)
NVIDIA_API_KEY=
NVIDIA_MODEL=moonshotai/kimi-k2.6
OPENAI_API_BASE=https://integrate.api.nvidia.com/v1

# Fallback: Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Fallback: OpenRouter
OPENROUTER_API_KEY=

# ── HERMES AGENT (Nous Research) ───────────────────────────────────────
HERMES_HOME=/root/.hermes
HERMES_AGENT_DIR=/root/.hermes/hermes-agent
HERMES_MEMORY_DIR=/root/.hermes/memory
HERMES_SESSION_DIR=/root/.hermes/sessions

# ── SWARM PROTOCOL ─────────────────────────────────────────────────────
AGENT_REPO_URL=https://github.com/dhaher-labs/agent.git
SWARM_HEARTBEAT=60
SWARM_TIMEOUT=300
BOT_NAME=traderbot

# ── MEMORY BRIDGE ──────────────────────────────────────────────────────
MEMORY_SYNC_INTERVAL=60
AGENT_REPO=https://github.com/dhaher-labs/agent.git

# ── MNEMOSYNE (Knowledge Memory) ───────────────────────────────────────
MNEMOSYNE_HOST=localhost
MNEMOSYNE_PORT=3001
MNEMOSYNE_URL=http://localhost:3001
MNEMOSYNE_MCP_PORT=3002

# ── HYPERGATE (LLM Router) ─────────────────────────────────────────────
HYPERGATE_PROXYGATE_URL=http://localhost:3333
HYPERGATE_CACHE_ENABLED=true
HYPERGATE_CACHE_TTL=3600

# ── TRADING ────────────────────────────────────────────────────────────
# Deployment stage: research_lab | paper_trading | micro_live | semi_autonomous | full_autonomous
DEPLOYMENT_STAGE=research_lab

# Target markets
TRADING_MARKETS=XAUUSD,EURUSD,GBPUSD,BTCUSDT

# Risk limits (HARDCODED — cannot be overridden by any agent)
RISK_MAX_PER_TRADE=0.005
RISK_DAILY_MAX=0.01
RISK_WEEKLY_MAX=0.03

# ── TELEGRAM ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── WALLETS (never commit real addresses) ──────────────────────────────
WALLET_TRON=
WALLET_SHIBA=

# ── IMMORTAL DAEMON ────────────────────────────────────────────────────
DAEMON_CHECK_INTERVAL=300
DAEMON_AUTO_UPGRADE=true
DAEMON_AUTO_HEAL=true
DAEMON_AUTO_EXPAND=true

# ── LOGGING ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=7
LOG_DIR=./logs
DATA_DIR=./data

# ── ECOSYSTEM REPOS ────────────────────────────────────────────────────
GITHUB_USER=dhaher-labs
ECOSYSTEM_INSTALL_DIR=$HOME/hermes-ecosystem

# ── DOCKER ─────────────────────────────────────────────────────────────
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE=dhaher-labs/hermes-hive
DOCKER_TAG=latest
